# Личное окружение Python и кэш.
.venv/
__pycache__/
*.py[cod]

# Локальная база хранит заявки и не должна публиковаться.
data/*.db

# В этих файлах PHP хранит временную сессию входа в админ-панель.
data/sessions/

# Временные зависимости, использованные только для локальной проверки.
.test-deps/

# Все рабочие данные, резервные копии и личные настройки.
data/
config.local.php
.env
.env.*
!.env.example
*.db
*.db-*
*.sqlite*
*.log
*.bak
*.zip
.idea/
.vscode/
Thumbs.db
.DS_Store

# Историческая Python-версия остаётся только на компьютере.
/app.py
/test_app.py
/requirements.txt
